<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/mainLayout"
    android:background="@drawable/german_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/TextLayout"
        android:background="@drawable/top_confirm_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:scrollbarAlwaysDrawVerticalTrack="true"
            android:textColor="#ffa7a7a7"
            android:gravity="center_horizontal"
            android:id="@+id/textView1"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="5dp"
            android:layout_marginBottom="10dp"
            android:text="TextView"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/buttonLayout"
        android:background="@drawable/bottom_confirm_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:textColor="#ffffffff"
            android:layout_gravity="center_vertical"
            android:id="@+id/button1"
            android:background="@drawable/german_later_button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="40dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="20dp"
            android:text="Later"
            android:layout_weight="1"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="20dp"/>
        <Button
            android:textColor="#ffffffff"
            android:layout_gravity="center_vertical"
            android:id="@+id/button2"
            android:background="@drawable/german_buy_button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="40dp"
            android:layout_marginBottom="20dp"
            android:text="OK"
            android:layout_weight="1"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="40dp"/>
    </LinearLayout>
</LinearLayout>
