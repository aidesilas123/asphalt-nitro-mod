    <string name="didomi_ccpa_notice_consent">&lt;p&gt;Shromažďujeme některé osobní údaje, jako je vaše IP adresa nebo soubory cookie prohlížeče, a prodáváme je třetím stranám. To nám pomáhá při poskytování personalizovaných reklam a při monitorování a zlepšování našich služeb. Můžete se ale rozhodnout se z prodeje odhlásit pomocí tlačítka níže.&lt;br /&gt;Další informace o vašich právech naleznete v našich &lt;a href=\"{privacyPolicyURL}\" target=\"_blank\"&gt;Zásadách ochrany osobních údajů&lt;/a&gt;.&lt;/p&gt;</string>
    <string name="didomi_ccpa_notice_consent_complete">&lt;h1&gt;Vaše soukromí&lt;/h1&gt;&lt;p&gt;Shromažďujeme některé osobní údaje, jako je vaše IP adresa nebo soubory cookie prohlížeče, a prodáváme je třetím stranám. To nám pomáhá při poskytování personalizovaných reklam a při monitorování a zlepšování našich služeb. Můžete se ale rozhodnout se z prodeje odhlásit pomocí tlačítka níže.&lt;br /&gt;Další informace o vašich právech naleznete v našich &lt;a href=\"{privacyPolicyURL}\" target=\"_blank\"&gt;Zásadách ochrany osobních údajů&lt;/a&gt;.&lt;/p&gt;</string>
    <string name="didomi_ccpa_notice_dismiss">Souhlasit a zavřít</string>
    <string name="didomi_ccpa_notice_learn_more">Neprodávejte mé údaje</string>
