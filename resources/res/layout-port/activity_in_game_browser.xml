<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ingamebrowser_mview"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@android:color/black"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:background="#ffc3c3c3"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_margin="1dp"
            android:layout_weight="0.07">
            <ImageButton
                android:id="@+id/ingamebrowser_closebutton"
                android:background="@android:color/transparent"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/navigation_cancel"
                android:scaleType="centerInside"
                android:layout_alignParentLeft="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/ingamebrowser_webview"
            android:background="@android:color/white"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginLeft="1dp"
            android:layout_marginRight="1dp"
            android:layout_weight="0.86"/>
        <RelativeLayout
            android:background="#ffc3c3c3"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_margin="1dp"
            android:layout_weight="0.07">
            <ImageButton
                android:id="@+id/ingamebrowser_backbutton"
                android:background="@android:color/transparent"
                android:paddingRight="5dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/navigation_back"
                android:scaleType="centerInside"
                android:layout_alignParentLeft="true"/>
            <ImageButton
                android:id="@+id/ingamebrowser_forwardbutton"
                android:background="@android:color/transparent"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/navigation_forward"
                android:scaleType="centerInside"
                android:layout_toRightOf="@+id/ingamebrowser_backbutton"/>
            <ImageButton
                android:id="@+id/ingamebrowser_refreshbutton"
                android:background="@android:color/transparent"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/navigation_refresh"
                android:scaleType="centerInside"
                android:layout_alignParentRight="true"/>
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>
