<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="@integer/didomi_focus_animation_time"
    android:exitFadeDuration="@integer/didomi_focus_animation_time">
    <item
        android:state_selected="true"
        android:drawable="@color/didomi_tv_background_a"/>
    <item
        android:state_focused="true"
        android:drawable="@color/didomi_tv_focused"/>
    <item android:drawable="@color/didomi_tv_background_b"/>
</selector>
