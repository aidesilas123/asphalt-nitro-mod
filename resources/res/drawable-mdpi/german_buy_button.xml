<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient
                android:startColor="#ff91eb96"
                android:endColor="#ff91eb96"
                android:angle="0"/>
            <padding
                android:left="10dp"
                android:top="10dp"
                android:right="10dp"
                android:bottom="10dp"/>
            <corners
                android:radius="90dp"
                android:topLeftRadius="25dp"
                android:topRightRadius="25dp"
                android:bottomLeftRadius="25dp"
                android:bottomRightRadius="25dp"/>
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <gradient
                android:startColor="#ff91eb96"
                android:endColor="#ff91eb96"
                android:angle="0"/>
            <padding
                android:left="10dp"
                android:top="10dp"
                android:right="10dp"
                android:bottom="10dp"/>
            <corners
                android:radius="90dp"
                android:topLeftRadius="25dp"
                android:topRightRadius="25dp"
                android:bottomLeftRadius="25dp"
                android:bottomRightRadius="25dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:startColor="#ff10a63e"
                android:endColor="#ff10a63e"
                android:angle="0"/>
            <padding
                android:left="10dp"
                android:top="10dp"
                android:right="10dp"
                android:bottom="10dp"/>
            <corners
                android:radius="90dp"
                android:topLeftRadius="25dp"
                android:topRightRadius="25dp"
                android:bottomLeftRadius="25dp"
                android:bottomRightRadius="25dp"/>
        </shape>
    </item>
</selector>
