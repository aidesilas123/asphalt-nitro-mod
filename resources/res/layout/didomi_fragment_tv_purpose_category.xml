<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_ctv_purpose_category_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/didomi_view_tv_secondary_background"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list_ctv_purpose_category"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        app:layout_constraintBottom_toTopOf="@+id/view_ctv_purpose_category"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="spread_inside"/>
    <View
        android:id="@+id/view_ctv_purpose_category"
        android:background="@drawable/didomi_tv_purposes_gradient_bottom"
        android:layout_width="match_parent"
        android:layout_height="@dimen/didomi_tv_preferences_foreground_height_default"
        android:layout_marginStart="@dimen/didomi_tv_shadow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/list_ctv_purpose_category"/>
</androidx.constraintlayout.widget.ConstraintLayout>
