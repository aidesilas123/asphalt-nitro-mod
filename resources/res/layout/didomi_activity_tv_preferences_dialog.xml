<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/include_ctv_preferences_menu"
        layout="@layout/didomi_view_tv_preferences_primary"/>
    <View
        android:id="@+id/view_ctv_preferences_background"
        android:background="@color/didomi_tv_secondary_brand"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/container_ctv_preferences_secondary"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/didomi_tv_slider_margin_start"/>
</androidx.constraintlayout.widget.ConstraintLayout>
