<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/didomi_bottom_height"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">
    <ImageView
        android:id="@+id/image_purpose_save_logo"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@mipmap/didomi_brand_logo"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:gravity="end"
        android:id="@+id/text_purpose_save_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="4"
        android:layout_weight="1"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/button_purpose_save"
        app:layout_constraintStart_toEndOf="@+id/image_purpose_save_logo"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/DidomiTextSmall"/>
    <Button
        android:id="@+id/button_purpose_save"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/DidomiActionButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
