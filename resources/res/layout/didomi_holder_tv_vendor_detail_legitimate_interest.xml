<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/didomi_tv_bg_recycle_view"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="@dimen/didomi_tv_preferences_item_height"
    android:layout_marginBottom="@dimen/didomi_tv_purposes_margin_bottom">
    <androidx.appcompat.widget.AppCompatCheckBox
        android:id="@+id/checkbox_ctv_vendor_detail_legitimate_interest"
        android:background="@null"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:duplicateParentState="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:button="@drawable/didomi_tv_checkbox"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:buttonTint="@color/didomi_se_default_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/text_ctv_vendor_detail_legitimate_interest_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/didomi_se_default_button"
        android:id="@+id/text_ctv_vendor_detail_legitimate_interest_title"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:duplicateParentState="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/text_ctv_vendor_detail_legitimate_interest_status"
        app:layout_constraintEnd_toStartOf="@+id/image_ctv_vendor_detail_legitimate_interest"
        app:layout_constraintStart_toEndOf="@+id/checkbox_ctv_vendor_detail_legitimate_interest"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/DidomiTVTextAction"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/didomi_se_default_button"
        android:id="@+id/text_ctv_vendor_detail_legitimate_interest_status"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:duplicateParentState="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/text_ctv_vendor_detail_legitimate_interest_title"
        app:layout_constraintStart_toStartOf="@+id/text_ctv_vendor_detail_legitimate_interest_title"
        app:layout_constraintTop_toBottomOf="@+id/text_ctv_vendor_detail_legitimate_interest_title"
        style="@style/DidomiTVTextSmall"/>
    <ImageView
        android:id="@+id/image_ctv_vendor_detail_legitimate_interest"
        android:background="@android:color/transparent"
        android:duplicateParentState="true"
        android:layout_width="8dp"
        android:layout_height="12dp"
        android:src="@drawable/didomi_se_ctv_arrow"
        android:contentDescription="@null"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="49dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/text_ctv_vendor_detail_legitimate_interest_title"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
