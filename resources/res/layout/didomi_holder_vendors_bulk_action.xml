<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/didomi_vendors_item_height">
    <TextView
        android:id="@+id/text_vendors_bulk_action"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:importantForAccessibility="no"
        android:layout_marginStart="24dp"
        style="@style/DidomiHeaderSmall"/>
    <io.didomi.drawable.view.mobile.DidomiToggle
        android:id="@+id/toggle_vendors_bulk_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:layout_marginEnd="45dp"/>
</LinearLayout>
