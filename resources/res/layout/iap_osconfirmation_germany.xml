<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/mainLayout"
    android:background="@drawable/german_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/TextLayout"
        android:background="@drawable/top_confirm_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:scrollbarAlwaysDrawVerticalTrack="true"
            android:textColor="#ffa7a7a7"
            android:id="@+id/textView1"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="15dp"
            android:layout_marginBottom="20dp"
            android:text="TextView"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/buttonLayout"
        android:background="@android:color/background_light"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:textStyle="bold"
            android:textColor="#ff020852"
            android:layout_gravity="center_vertical"
            android:id="@+id/button2"
            android:background="@drawable/german_buy_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="3dp"
            android:layout_marginTop="3dp"
            android:layout_marginRight="3dp"
            android:layout_marginBottom="2dp"
            android:text="Zahlungspflichtig Bestellen"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/buttonLayout2"
        android:background="@android:color/background_light"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:textStyle="bold"
            android:textColor="#ff020852"
            android:layout_gravity="center_vertical"
            android:id="@+id/btnTnC"
            android:background="@drawable/german_buy_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="3dp"
            android:layout_marginTop="3dp"
            android:layout_marginRight="3dp"
            android:layout_marginBottom="2dp"
            android:text="Terms And Conditions"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/buttonLayout1"
        android:background="@drawable/bottom_confirm_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:textStyle="bold"
            android:textColor="#ff020852"
            android:layout_gravity="center_vertical"
            android:id="@+id/button1"
            android:background="@drawable/german_buy_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="3dp"
            android:layout_marginTop="3dp"
            android:layout_marginRight="3dp"
            android:layout_marginBottom="2dp"
            android:text="Back"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
