<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/view_ctv_preferences_menu_background"
        android:background="@color/didomi_tv_background_b"
        android:layout_width="285dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/image_ctv_preferences_logo"
        android:background="@android:color/transparent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="28dp"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:maxHeight="40dp"
        app:layout_constraintStart_toStartOf="@+id/view_ctv_preferences_menu_background"
        app:layout_constraintTop_toTopOf="@+id/view_ctv_preferences_menu_background"/>
    <Button
        android:id="@+id/button_ctv_preferences_tab_purpose"
        android:nextFocusUp="@+id/button_ctv_preferences_disagree"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:paddingStart="@dimen/didomi_tv_tab_padding_start"
        android:paddingEnd="@dimen/didomi_tv_tab_padding_end"
        app:layout_constraintEnd_toEndOf="@+id/view_ctv_preferences_menu_background"
        app:layout_constraintStart_toStartOf="@+id/view_ctv_preferences_menu_background"
        app:layout_constraintTop_toBottomOf="@+id/image_ctv_preferences_logo"
        style="@style/DidomiTVPreferencesTab"/>
    <Button
        android:id="@+id/button_ctv_preferences_tab_vendor"
        android:nextFocusDown="@+id/button_ctv_preferences_save"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/didomi_tv_button_margin_bottom"
        android:paddingStart="@dimen/didomi_tv_tab_padding_start"
        android:paddingEnd="@dimen/didomi_tv_tab_padding_end"
        app:layout_constraintEnd_toEndOf="@+id/view_ctv_preferences_menu_background"
        app:layout_constraintStart_toStartOf="@+id/view_ctv_preferences_menu_background"
        app:layout_constraintTop_toBottomOf="@+id/button_ctv_preferences_tab_purpose"
        style="@style/DidomiTVPreferencesTab"/>
    <View
        android:id="@+id/view_ctv_preferences_divider"
        android:background="@color/didomi_tv_background_c"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:layout_marginBottom="@dimen/didomi_tv_preferences_button_margin_bottom"
        app:layout_constraintBottom_toTopOf="@+id/button_ctv_preferences_save"
        app:layout_constraintEnd_toEndOf="@+id/button_ctv_preferences_save"
        app:layout_constraintStart_toStartOf="@+id/button_ctv_preferences_save"/>
    <Button
        android:id="@+id/button_ctv_preferences_save"
        android:nextFocusUp="@+id/button_ctv_preferences_tab_vendor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/didomi_tv_preferences_button_margin_bottom"
        android:paddingStart="@dimen/didomi_tv_button_padding"
        android:paddingEnd="@dimen/didomi_tv_button_padding"
        app:layout_constraintBottom_toTopOf="@+id/button_ctv_preferences_agree"
        app:layout_constraintEnd_toEndOf="@+id/view_ctv_preferences_menu_background"
        app:layout_constraintStart_toStartOf="@+id/view_ctv_preferences_menu_background"
        style="@style/DidomiTVButton"/>
    <Button
        android:id="@+id/button_ctv_preferences_agree"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/didomi_tv_preferences_button_margin_bottom"
        android:paddingStart="@dimen/didomi_tv_button_padding"
        android:paddingEnd="@dimen/didomi_tv_button_padding"
        app:layout_constraintBottom_toTopOf="@+id/button_ctv_preferences_disagree"
        app:layout_constraintEnd_toEndOf="@+id/view_ctv_preferences_menu_background"
        app:layout_constraintStart_toStartOf="@+id/view_ctv_preferences_menu_background"
        style="@style/DidomiTVButton"/>
    <Button
        android:id="@+id/button_ctv_preferences_disagree"
        android:nextFocusDown="@+id/button_ctv_preferences_tab_purpose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:paddingStart="@dimen/didomi_tv_button_padding"
        android:paddingEnd="@dimen/didomi_tv_button_padding"
        app:layout_constraintBottom_toBottomOf="@+id/view_ctv_preferences_menu_background"
        app:layout_constraintEnd_toEndOf="@+id/view_ctv_preferences_menu_background"
        app:layout_constraintStart_toStartOf="@+id/view_ctv_preferences_menu_background"
        style="@style/DidomiTVButton"/>
    <FrameLayout
        android:id="@+id/container_ctv_preferences_primary"
        android:background="@color/didomi_tv_background_a"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/view_ctv_preferences_menu_background"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
