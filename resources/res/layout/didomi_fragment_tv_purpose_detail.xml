<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_ctv_purpose_detail_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/didomi_view_tv_secondary_background"/>
    <TextView
        android:id="@+id/text_ctv_purpose_detail_title"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:layout_marginStart="@dimen/didomi_tv_slider_text_margin_start"
        app:layout_constraintBottom_toTopOf="@+id/text_ctv_purpose_detail_description"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/DidomiTVTextHeadingLarge"/>
    <TextView
        android:id="@+id/text_ctv_purpose_detail_description"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:alpha="0.8"
        android:layout_marginStart="@dimen/didomi_tv_slider_text_margin_start"
        app:layout_constraintBottom_toTopOf="@+id/button_ctv_purpose_detail_read_more"
        app:layout_constraintTop_toBottomOf="@+id/text_ctv_purpose_detail_title"
        style="@style/DidomiTVTextSmall"/>
    <Button
        android:textSize="13sp"
        android:textColor="@color/didomi_se_default_button"
        android:gravity="center_vertical"
        android:id="@+id/button_ctv_purpose_detail_read_more"
        android:background="@drawable/didomi_tv_bg_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        android:minHeight="48dp"
        android:drawableRight="@drawable/didomi_ic_tv_arrow_right"
        android:drawableEnd="@drawable/didomi_ic_tv_arrow_right"
        android:fontFamily="sans-serif-condensed"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginStart="@dimen/didomi_tv_slider_text_margin_start"
        android:layout_marginEnd="@dimen/didomi_tv_slider_text_margin_start"
        app:layout_constraintBottom_toTopOf="@+id/view_ctv_purpose_detail_divider"
        app:layout_constraintTop_toBottomOf="@+id/text_ctv_purpose_detail_description"
        style="@style/DidomiTVTextAction"/>
    <View
        android:id="@+id/view_ctv_purpose_detail_divider"
        android:background="@color/didomi_tv_background_c"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/text_ctv_purpose_detail_settings_title"
        app:layout_constraintEnd_toEndOf="@+id/include_ctv_purpose_detail_consent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="@+id/include_ctv_purpose_detail_consent"
        app:layout_constraintTop_toBottomOf="@+id/button_ctv_purpose_detail_read_more"/>
    <TextView
        android:id="@+id/text_ctv_purpose_detail_settings_title"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:alpha="0.8"
        android:layout_marginStart="@dimen/didomi_tv_slider_text_margin_start"
        app:layout_constraintBottom_toTopOf="@+id/include_ctv_purpose_detail_consent"
        app:layout_constraintTop_toBottomOf="@+id/view_ctv_purpose_detail_divider"
        style="@style/DidomiTVTextSmall"/>
    <include
        android:id="@+id/include_ctv_purpose_detail_consent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="@dimen/didomi_tv_slider_text_margin_start"
        android:layout_marginEnd="@dimen/didomi_tv_slider_text_margin_end"
        app:layout_constraintBottom_toTopOf="@+id/include_ctv_purpose_detail_legitimate_interest"
        app:layout_constraintTop_toBottomOf="@+id/text_ctv_purpose_detail_settings_title"
        layout="@layout/didomi_view_tv_item_switch"/>
    <include
        android:id="@+id/include_ctv_purpose_detail_legitimate_interest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/didomi_tv_slider_text_margin_start"
        android:layout_marginEnd="@dimen/didomi_tv_slider_text_margin_end"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/include_ctv_purpose_detail_consent"
        layout="@layout/didomi_view_tv_item_checkbox"/>
</androidx.constraintlayout.widget.ConstraintLayout>
