<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/button_purpose_vendors_close"
        android:background="@null"
        android:padding="24dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:contentDescription="@string/didomi_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/didomi_ic_round_close_24px"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:id="@+id/text_purpose_vendors_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/didomi_purpose_vendors_title_margin_horizontal"
        android:layout_marginStart="@dimen/didomi_notice_padding_horizontal"
        android:layout_marginEnd="@dimen/didomi_notice_padding_horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/button_purpose_vendors_close"
        app:layout_constraintWidth_max="@dimen/didomi_content_max_width"/>
    <TextView
        android:id="@+id/button_purpose_vendors_non_iab_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/didomi_purpose_vendors_count_padding_horizontal"
        app:layout_constraintStart_toStartOf="@+id/text_purpose_vendors_title"
        app:layout_constraintTop_toBottomOf="@+id/text_purpose_vendors_title"
        style="@style/DidomiCountDetail"/>
    <TextView
        android:id="@+id/button_purpose_vendors_iab_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/didomi_purpose_vendors_count_padding_horizontal"
        app:layout_constraintStart_toEndOf="@+id/button_purpose_vendors_non_iab_count"
        app:layout_constraintTop_toBottomOf="@+id/text_purpose_vendors_title"
        style="@style/DidomiCountDetail"/>
    <androidx.recyclerview.widget.RecyclerView
        android:scrollbarStyle="outsideOverlay"
        android:id="@+id/list_purpose_vendors"
        android:paddingBottom="@dimen/didomi_purpose_list_padding_bottom"
        android:scrollbars="vertical"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/didomi_purpose_vendors_list_margin_horizontal"
        android:paddingStart="@dimen/didomi_notice_padding_horizontal"
        android:paddingEnd="@dimen/didomi_notice_padding_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_purpose_vendors_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
