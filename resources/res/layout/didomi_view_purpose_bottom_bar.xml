<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/didomi_bottom_height"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">
    <ImageView
        android:id="@+id/image_purpose_bottom_bar_logo"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@mipmap/didomi_brand_logo"
        android:layout_marginEnd="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/flow_purpose_bottom_bar"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.helper.widget.Flow
        android:id="@+id/flow_purpose_bottom_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="button_purpose_bottom_bar_disagree,button_purpose_bottom_bar_agree"
        app:flow_horizontalGap="16dp"
        app:flow_lastHorizontalBias="2"
        app:flow_lastHorizontalStyle="spread_inside"
        app:flow_maxElementsWrap="2"
        app:flow_verticalGap="4dp"
        app:flow_wrapMode="chain"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/image_purpose_bottom_bar_logo"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/button_purpose_bottom_bar_disagree"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/DidomiActionButton"/>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/button_purpose_bottom_bar_agree"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/DidomiActionButton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
