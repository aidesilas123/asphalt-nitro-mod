<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/button_vendor_detail_header_close"
        android:background="@null"
        android:padding="24dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:contentDescription="@string/didomi_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/didomi_ic_round_close_24px"/>
    <io.didomi.drawable.view.mobile.HeaderView
        android:id="@+id/vendor_detail_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/vendor_scroll_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/didomi_content_max_width"/>
    <androidx.core.widget.NestedScrollView
        android:scrollbarStyle="outsideOverlay"
        android:id="@+id/vendor_scroll_view"
        android:paddingBottom="24dp"
        android:scrollbars="vertical"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintBottom_toTopOf="@+id/vendors_footer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vendor_detail_header">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:isScrollContainer="true">
            <TextView
                android:id="@+id/vendor_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="@dimen/didomi_content_max_width_without_padding"
                style="@style/DidomiScreenTitle"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/vendor_consent_dataprocessing_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="vendor_consent_dataprocessing_title,vendor_consent_dataprocessing_switch"/>
            <TextView
                android:id="@+id/vendor_consent_dataprocessing_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:layout_constraintEnd_toStartOf="@+id/vendor_consent_dataprocessing_switch"
                app:layout_constraintStart_toStartOf="@+id/vendor_title"
                app:layout_constraintTop_toBottomOf="@+id/vendor_title"
                style="@style/DidomiHeaderSmall"/>
            <io.didomi.drawable.view.mobile.DidomiToggle
                android:layout_gravity="center"
                android:id="@+id/vendor_consent_dataprocessing_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/vendor_consent_dataprocessing_title"
                app:layout_constraintEnd_toEndOf="@+id/vendor_title"
                app:layout_constraintStart_toEndOf="@+id/vendor_consent_dataprocessing_title"
                app:layout_constraintTop_toTopOf="@+id/vendor_consent_dataprocessing_title"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/vendor_consent_dataprocessing_list"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/vendor_consent_dataprocessing_title"
                app:layout_constraintWidth_max="@dimen/didomi_content_max_width_without_padding"/>
            <View
                android:id="@+id/vendor_consent_separator"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/vendor_consent_dataprocessing_list"
                app:layout_constraintWidth_max="@dimen/didomi_content_max_width_without_padding"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/vendor_li_dataprocessing_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="vendor_li_dataprocessing_title,vendor_li_dataprocessing_switch"/>
            <TextView
                android:id="@+id/vendor_li_dataprocessing_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toStartOf="@+id/vendor_li_dataprocessing_switch"
                app:layout_constraintStart_toStartOf="@+id/vendor_title"
                app:layout_constraintTop_toBottomOf="@+id/vendor_consent_separator"
                style="@style/DidomiHeaderSmall"/>
            <io.didomi.drawable.view.mobile.DidomiToggle
                android:layout_gravity="center"
                android:id="@+id/vendor_li_dataprocessing_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:didomi_has_middle_state="false"
                app:layout_constraintBottom_toBottomOf="@+id/vendor_li_dataprocessing_title"
                app:layout_constraintEnd_toEndOf="@+id/vendor_title"
                app:layout_constraintStart_toEndOf="@+id/vendor_li_dataprocessing_title"
                app:layout_constraintTop_toTopOf="@+id/vendor_li_dataprocessing_title"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/vendor_li_dataprocessing_list"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/vendor_li_dataprocessing_title"
                app:layout_constraintWidth_max="@dimen/didomi_content_max_width_without_padding"/>
            <View
                android:id="@+id/vendor_li_separator"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/vendor_li_dataprocessing_list"
                app:layout_constraintWidth_max="@dimen/didomi_content_max_width_without_padding"/>
            <TextView
                android:id="@+id/vendor_additional_dataprocessing_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/vendor_li_separator"
                app:layout_constraintWidth_max="@dimen/didomi_content_max_width_without_padding"
                style="@style/DidomiHeaderSmall"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/vendor_additional_dataprocessing_list"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/vendor_additional_dataprocessing_title"
                app:layout_constraintWidth_max="@dimen/didomi_content_max_width_without_padding"/>
            <View
                android:id="@+id/vendor_additional_dataprocessing_separator"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/vendor_additional_dataprocessing_list"
                app:layout_constraintWidth_max="@dimen/didomi_content_max_width_without_padding"/>
            <TextView
                android:id="@+id/vendor_essential_purposes_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/vendor_additional_dataprocessing_separator"
                app:layout_constraintWidth_max="@dimen/didomi_content_max_width_without_padding"
                style="@style/DidomiHeaderSmall"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/vendor_essential_purposes_list"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/vendor_essential_purposes_title"
                app:layout_constraintWidth_max="@dimen/didomi_content_max_width_without_padding"/>
            <View
                android:id="@+id/vendor_essential_purposes_separator"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/vendor_essential_purposes_list"
                app:layout_constraintWidth_max="@dimen/didomi_content_max_width_without_padding"/>
            <TextView
                android:id="@+id/vendor_data_categories_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/vendor_essential_purposes_separator"
                app:layout_constraintWidth_max="@dimen/didomi_content_max_width_without_padding"
                style="@style/DidomiHeaderSmall"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/vendor_data_categories_list"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/vendor_data_categories_title"
                app:layout_constraintWidth_max="@dimen/didomi_content_max_width_without_padding"/>
            <View
                android:id="@+id/vendor_data_categories_separator"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/vendor_data_categories_list"
                app:layout_constraintWidth_max="@dimen/didomi_content_max_width_without_padding"/>
            <TextView
                android:textSize="12sp"
                android:id="@+id/vendor_privacy_policy_disclaimer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:lineSpacingExtra="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/vendor_data_categories_separator"
                app:layout_constraintWidth_max="@dimen/didomi_content_max_width_without_padding"
                style="@style/DidomiTextSmallPlus"/>
            <androidx.appcompat.widget.AppCompatButton
                android:textSize="12sp"
                android:id="@+id/vendor_iab_tcf_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintStart_toStartOf="@+id/vendor_privacy_policy_disclaimer"
                app:layout_constraintTop_toBottomOf="@+id/vendor_privacy_policy_disclaimer"
                style="@style/DidomiPreferencesDetailLink"/>
            <androidx.appcompat.widget.AppCompatButton
                android:textSize="12sp"
                android:id="@+id/vendor_privacy_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintStart_toStartOf="@+id/vendor_privacy_policy_disclaimer"
                app:layout_constraintTop_toBottomOf="@+id/vendor_iab_tcf_link"
                style="@style/DidomiPreferencesDetailLink"/>
            <androidx.appcompat.widget.AppCompatButton
                android:textSize="12sp"
                android:id="@+id/vendor_leg_int_claim_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintStart_toStartOf="@+id/vendor_privacy_policy_disclaimer"
                app:layout_constraintTop_toBottomOf="@+id/vendor_privacy_link"
                style="@style/DidomiPreferencesDetailLink"/>
            <TextView
                android:id="@+id/vendor_cookies_section_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/vendor_leg_int_claim_link"
                app:layout_constraintWidth_max="@dimen/didomi_content_max_width_without_padding"
                style="@style/DidomiHeaderSmall"/>
            <TextView
                android:textSize="12sp"
                android:id="@+id/vendor_cookies_section_disclaimer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/vendor_cookies_section_title"
                app:layout_constraintWidth_max="@dimen/didomi_content_max_width_without_padding"
                style="@style/DidomiDescriptiveText"/>
            <TextView
                android:textSize="12sp"
                android:id="@+id/vendor_device_storage_disclosures_link"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/vendor_cookies_section_disclaimer"
                app:layout_constraintWidth_max="@dimen/didomi_content_max_width_without_padding"
                style="@style/DidomiDescriptiveText"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/vendor_device_storage_disclosures_list"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:overScrollMode="never"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/vendor_device_storage_disclosures_link"
                app:layout_constraintWidth_max="@dimen/didomi_content_max_width_without_padding"/>
            <ProgressBar
                android:id="@+id/vendor_device_storage_disclosures_loader"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:indeterminate="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/vendor_cookies_section_disclaimer"
                app:layout_constraintWidth_max="@dimen/didomi_content_max_width_without_padding"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <View
        android:id="@+id/view_vendors_bottom_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintBottom_toTopOf="@+id/vendors_footer"/>
    <include
        android:id="@+id/vendors_footer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/didomi_bottom_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vendor_scroll_view"
        app:layout_constraintWidth_max="@dimen/didomi_content_max_width"
        layout="@layout/didomi_view_vendors_footer"/>
</androidx.constraintlayout.widget.ConstraintLayout>
