<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/view_ctv_purpose_detail_divider"
        android:background="@color/didomi_tv_background_c"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"/>
    <TextView
        android:id="@+id/text_ctv_purpose_additional_info_vendors_count_title"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:alpha="0.8"
        style="@style/DidomiTVTextSmall"/>
    <Button
        android:textSize="13sp"
        android:textColor="@color/didomi_se_default_button"
        android:gravity="center_vertical"
        android:id="@+id/button_ctv_purpose_additional_info_vendors_count"
        android:background="@drawable/didomi_tv_bg_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:drawableRight="@drawable/didomi_ic_tv_arrow_right"
        android:textAllCaps="false"
        android:drawableEnd="@drawable/didomi_ic_tv_arrow_right"
        android:fontFamily="sans-serif-condensed"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        style="@style/DidomiTVTextAction"/>
</LinearLayout>
