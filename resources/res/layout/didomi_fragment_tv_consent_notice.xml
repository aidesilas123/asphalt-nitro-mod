<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/view_ctv_notice_side_main"
        android:background="@color/didomi_tv_background_a"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/view_ctv_notice_side_end"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/view_ctv_notice_side_main_shadow"
        android:background="@drawable/didomi_tv_shadow"
        android:layout_width="6dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/view_ctv_notice_side_end"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/image_ctv_notice_logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="28dp"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:maxHeight="40dp"
        app:layout_constraintBottom_toTopOf="@+id/text_ctv_notice_content"
        app:layout_constraintStart_toStartOf="@+id/text_ctv_notice_content"
        app:layout_constraintTop_toTopOf="@+id/view_ctv_notice_side_main"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:id="@+id/text_ctv_notice_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:alpha="0.8"
        android:layout_marginStart="112dp"
        android:layout_marginEnd="112dp"
        app:layout_constraintBottom_toTopOf="@+id/view_ctv_notice_divider"
        app:layout_constraintEnd_toEndOf="@+id/view_ctv_notice_side_main"
        app:layout_constraintStart_toStartOf="@+id/view_ctv_notice_side_main"
        app:layout_constraintTop_toBottomOf="@+id/image_ctv_notice_logo"
        style="@style/DidomiTVTextLarge"/>
    <View
        android:id="@+id/view_ctv_notice_divider"
        android:background="@color/didomi_tv_background_c"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toTopOf="@+id/button_ctv_notice_privacy"
        app:layout_constraintEnd_toEndOf="@+id/text_ctv_notice_content"
        app:layout_constraintStart_toStartOf="@+id/text_ctv_notice_content"
        app:layout_constraintTop_toBottomOf="@+id/text_ctv_notice_content"/>
    <Button
        android:id="@+id/button_ctv_notice_privacy"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/didomi_tv_button_width"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/view_ctv_notice_side_main"
        app:layout_constraintEnd_toStartOf="@+id/button_ctv_notice_partners"
        app:layout_constraintStart_toStartOf="@+id/text_ctv_notice_content"
        app:layout_constraintTop_toBottomOf="@+id/view_ctv_notice_divider"
        style="@style/DidomiTVNoticeButton"/>
    <Button
        android:id="@+id/button_ctv_notice_partners"
        android:nextFocusRight="@+id/button_ctv_notice_agree"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/text_ctv_notice_content"
        app:layout_constraintStart_toEndOf="@+id/button_ctv_notice_privacy"
        app:layout_constraintTop_toTopOf="@+id/button_ctv_notice_privacy"
        style="@style/DidomiTVNoticeButton"/>
    <View
        android:id="@+id/view_ctv_notice_side_end"
        android:background="@color/didomi_tv_background_b"
        android:layout_width="285dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <Button
        android:id="@+id/button_ctv_notice_select"
        android:nextFocusLeft="@+id/button_ctv_notice_partners"
        android:nextFocusDown="@+id/button_ctv_notice_agree"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toTopOf="@+id/button_ctv_notice_agree"
        app:layout_constraintEnd_toEndOf="@+id/view_ctv_notice_side_end"
        app:layout_constraintStart_toStartOf="@+id/view_ctv_notice_side_end"
        app:layout_constraintTop_toTopOf="@+id/view_ctv_notice_side_end"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/DidomiTVNoticeButton"/>
    <Button
        android:id="@+id/button_ctv_notice_agree"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toTopOf="@+id/button_ctv_notice_disagree"
        app:layout_constraintEnd_toEndOf="@+id/view_ctv_notice_side_end"
        app:layout_constraintStart_toStartOf="@+id/view_ctv_notice_side_end"
        app:layout_constraintTop_toBottomOf="@+id/button_ctv_notice_select"
        style="@style/DidomiTVNoticeButton"/>
    <Button
        android:id="@+id/button_ctv_notice_disagree"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toTopOf="@+id/button_ctv_notice_learn_more"
        app:layout_constraintEnd_toEndOf="@+id/view_ctv_notice_side_end"
        app:layout_constraintStart_toStartOf="@+id/view_ctv_notice_side_end"
        app:layout_constraintTop_toBottomOf="@+id/button_ctv_notice_agree"
        style="@style/DidomiTVNoticeButton"/>
    <Button
        android:id="@+id/button_ctv_notice_learn_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/view_ctv_notice_side_end"
        app:layout_constraintEnd_toEndOf="@+id/view_ctv_notice_side_end"
        app:layout_constraintStart_toStartOf="@+id/view_ctv_notice_side_end"
        app:layout_constraintTop_toBottomOf="@+id/button_ctv_notice_disagree"
        style="@style/DidomiTVNoticeButton"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:alpha="0.25"
        app:layout_constraintBottom_toBottomOf="@+id/view_ctv_notice_side_end"
        app:layout_constraintEnd_toEndOf="@+id/view_ctv_notice_side_end"
        app:layout_constraintStart_toStartOf="@+id/view_ctv_notice_side_end"
        app:srcCompat="@drawable/didomi_tv_logo"/>
</androidx.constraintlayout.widget.ConstraintLayout>
