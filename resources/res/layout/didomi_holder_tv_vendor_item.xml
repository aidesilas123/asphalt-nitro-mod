<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_ctv_vendor_item"
    android:background="@drawable/didomi_tv_bg_recycle_view"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="@dimen/didomi_tv_preferences_item_height"
    android:layout_marginBottom="@dimen/didomi_tv_purposes_margin_bottom">
    <io.didomi.drawable.view.ctv.DidomiTVSwitch
        android:id="@+id/switch_ctv_vendor_item"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/text_ctv_vendor_item_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/didomi_se_ctv_purpose_holder_text"
        android:id="@+id/text_ctv_vendor_item_title"
        android:duplicateParentState="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginStart="15dp"
        app:layout_constraintBottom_toTopOf="@+id/text_ctv_vendor_item_status"
        app:layout_constraintStart_toEndOf="@+id/switch_ctv_vendor_item"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/DidomiTVTextAction"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/didomi_se_ctv_purpose_holder_text"
        android:id="@+id/text_ctv_vendor_item_status"
        android:duplicateParentState="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/text_ctv_vendor_item_title"
        app:layout_constraintTop_toBottomOf="@+id/text_ctv_vendor_item_title"
        style="@style/DidomiTVTextSmall"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/didomi_se_ctv_info_tag_holder_text"
        android:id="@+id/text_ctv_vendor_item_iabtcf_tag"
        android:duplicateParentState="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/didomi_iab_tag"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/text_ctv_vendor_item_title"
        app:layout_constraintEnd_toStartOf="@+id/image_ctv_vendor_item"
        app:layout_constraintStart_toEndOf="@+id/text_ctv_vendor_item_title"
        app:layout_constraintTop_toTopOf="@+id/text_ctv_vendor_item_title"
        style="@style/DidomiTVTextAction"/>
    <ImageView
        android:id="@+id/image_ctv_vendor_item"
        android:background="@android:color/transparent"
        android:duplicateParentState="true"
        android:layout_width="0dp"
        android:layout_height="12dp"
        android:src="@drawable/didomi_se_ctv_arrow"
        android:scaleType="fitEnd"
        android:contentDescription="@null"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="49dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/text_ctv_vendor_item_iabtcf_tag"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
