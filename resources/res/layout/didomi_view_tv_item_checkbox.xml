<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/didomi_tv_bg_recycle_view"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:descendantFocusability="beforeDescendants"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/didomi_tv_preferences_switch_checkbox_height"
    android:paddingStart="19dp"
    android:paddingEnd="16dp">
    <androidx.appcompat.widget.AppCompatCheckBox
        android:id="@+id/checkbox_tv_item"
        android:background="@null"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:duplicateParentState="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:button="@drawable/didomi_tv_checkbox"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="20dp"
        app:buttonTint="@color/didomi_se_default_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/text_checkbox_tv_item_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/didomi_se_default_button"
        android:id="@+id/text_checkbox_tv_item_title"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:duplicateParentState="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/text_checkbox_tv_item_subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/checkbox_tv_item"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/DidomiTVTextAction"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/didomi_se_default_button"
        android:id="@+id/text_checkbox_tv_item_subtitle"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:duplicateParentState="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/text_checkbox_tv_item_title"
        app:layout_constraintTop_toBottomOf="@+id/text_checkbox_tv_item_title"
        style="@style/DidomiTVTextSmall"/>
</androidx.constraintlayout.widget.ConstraintLayout>
