<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/TextLayout2"
        android:background="#ff152839"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:scrollbarAlwaysDrawVerticalTrack="true"
            android:textColor="#ffffffff"
            android:id="@+id/sms_description_text"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="15dp"
            android:layout_marginBottom="10dp"
            android:text="sms description"/>
        <TextView
            android:scrollbarAlwaysDrawVerticalTrack="true"
            android:textColor="#ff0090ff"
            android:id="@+id/sms_message_text"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="15dp"
            android:layout_marginBottom="10dp"
            android:text="GL Order"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/radioGroupLayout"
        android:background="#ffffffff"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RadioGroup
            android:orientation="vertical"
            android:id="@+id/sms_RadioGroup1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioButton
                android:textColor="@android:color/black"
                android:id="@+id/sms_btn_app_send"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="App Auto Send"/>
            <RadioButton
                android:textColor="@android:color/black"
                android:id="@+id/sms_btn_prefilled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Prefilled"/>
            <RadioButton
                android:textColor="@android:color/black"
                android:id="@+id/sms_btn_manual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manual send"/>
        </RadioGroup>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/buttonLayout"
        android:background="#ff606366"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:layout_gravity="center_vertical"
            android:id="@+id/sms_btn_Cancel"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginTop="3dp"
            android:text="Cancel"
            android:layout_weight="1"/>
        <Button
            android:layout_gravity="center_vertical"
            android:id="@+id/sms_btn_ok"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginTop="3dp"
            android:text="OK"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
