<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include layout="@layout/didomi_view_tv_secondary_background"/>
    <ImageView
        android:id="@+id/image_ctv_device_storage_disclosure_detail_left_arrow_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="44dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/layout_ctv_device_storage_disclosure_detail_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/didomi_tv_ic_chevron_left"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_ctv_device_storage_disclosure_detail_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/image_ctv_device_storage_disclosure_detail_right_arrow_image"
        app:layout_constraintStart_toEndOf="@+id/image_ctv_device_storage_disclosure_detail_left_arrow_image"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:id="@+id/text_ctv_device_storage_disclosure_detail_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            style="@style/DidomiTVTextHeadingLarge"/>
        <TextSwitcher
            android:id="@+id/switcher_ctv_device_storage_disclosure_detail_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:alpha="0.8"/>
        <ScrollView
            android:id="@+id/scroll_ctv_device_storage_disclosure_detail"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:isScrollContainer="true"
                android:animateLayoutChanges="true">
                <TextSwitcher
                    android:id="@+id/switcher_ctv_device_storage_disclosure_detail_description_legal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.8"/>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
    <ImageView
        android:id="@+id/image_ctv_device_storage_disclosure_detail_right_arrow_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="44dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/layout_ctv_device_storage_disclosure_detail_container"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/didomi_tv_ic_chevron_right"/>
</androidx.constraintlayout.widget.ConstraintLayout>
