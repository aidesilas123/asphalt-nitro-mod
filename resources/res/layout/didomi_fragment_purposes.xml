<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/button_purposes_close"
        android:background="@null"
        android:padding="24dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:contentDescription="@string/didomi_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/didomi_ic_round_close_24px"/>
    <io.didomi.drawable.view.mobile.HeaderView
        android:id="@+id/header_purposes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/list_purposes"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/didomi_content_max_width"/>
    <androidx.recyclerview.widget.RecyclerView
        android:scrollbarStyle="outsideOverlay"
        android:id="@+id/list_purposes"
        android:paddingBottom="@dimen/didomi_purpose_list_padding_bottom"
        android:scrollbars="vertical"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/layout_purposes_bottom_bars"
        app:layout_constraintTop_toBottomOf="@+id/header_purposes"/>
    <View
        android:id="@+id/view_purposes_bottom_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/list_purposes"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textStyle="bold"
        android:gravity="center"
        android:id="@+id/text_purposes_scroll_indicator"
        android:background="@drawable/didomi_bg_scroll_indicator"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_alignBottom="@+id/list_purposes"
        android:textAllCaps="true"
        android:importantForAccessibility="no"
        android:paddingStart="50dp"
        android:paddingEnd="50dp"
        app:layout_constraintBottom_toBottomOf="@+id/list_purposes"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <FrameLayout
        android:id="@+id/layout_purposes_bottom_bars"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/list_purposes"
        app:layout_constraintWidth_max="@dimen/didomi_content_max_width">
        <include
            android:id="@+id/layout_purposes_agree_disagree"
            android:layout_width="match_parent"
            android:layout_height="@dimen/didomi_bottom_height"
            layout="@layout/didomi_view_purpose_bottom_bar"/>
        <io.didomi.drawable.purpose.mobile.PurposeSaveView
            android:id="@+id/save_purposes"
            android:layout_width="match_parent"
            android:layout_height="@dimen/didomi_bottom_height"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
