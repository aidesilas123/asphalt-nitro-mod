<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/didomi_tv_bg_recycle_view"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="@dimen/didomi_tv_preferences_item_height"
    android:layout_marginBottom="@dimen/didomi_tv_purposes_margin_bottom"
    android:layout_marginEnd="96dp">
    <io.didomi.drawable.view.ctv.DidomiTVSwitch
        android:id="@+id/switch_ctv_vendor_bulk"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="13sp"
        android:id="@+id/text_ctv_vendor_bulk_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginStart="15dp"
        app:layout_constraintBottom_toTopOf="@+id/text_ctv_vendor_bulk_status"
        app:layout_constraintStart_toEndOf="@+id/switch_ctv_vendor_bulk"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/DidomiTVTextAction"/>
    <TextView
        android:textSize="12sp"
        android:id="@+id/text_ctv_vendor_bulk_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/switch_ctv_vendor_bulk"
        app:layout_constraintTop_toBottomOf="@+id/text_ctv_vendor_bulk_title"
        style="@style/DidomiTVTextSmall"/>
</androidx.constraintlayout.widget.ConstraintLayout>
