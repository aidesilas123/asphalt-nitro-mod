<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:id="@+id/hyprmx_next_container"
    android:background="@drawable/hyprmx_rounded_corner"
    android:visibility="gone"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/hyprmx_header_next_text_size"
        android:gravity="center"
        android:id="@+id/hyprmx_next"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:includeFontPadding="false"
        android:layout_alignParentLeft="true"
        android:contentDescription="@string/hyprmx_go_to_next_offer"/>
    <ImageView
        android:id="@+id/hyprmx_next_chevron"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:layout_width="12dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="3dp"
        android:layout_marginRight="3dp"
        android:src="@drawable/hyprmx_chevron"
        android:layout_toRightOf="@+id/hyprmx_next"
        android:layout_alignTop="@+id/hyprmx_next"
        android:layout_alignBottom="@+id/hyprmx_next"
        android:layout_centerVertical="true"/>
</RelativeLayout>
