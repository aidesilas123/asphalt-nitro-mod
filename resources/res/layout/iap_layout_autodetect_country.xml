<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/layout_autodectect_country"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TableRow
            android:id="@+id/tableRow3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:layout_gravity="center"
                android:id="@+id/tvCountry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:text="@string/cs_label_country"/>
            <Spinner
                android:gravity="center"
                android:id="@+id/gdc_spin_autodetect_dialog_country"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="3dp"/>
        </TableRow>
        <TableRow
            android:id="@+id/tableRow4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:layout_gravity="center"
                android:id="@+id/tvOperator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:text="@string/cs_label_operator"/>
            <Spinner
                android:gravity="center"
                android:id="@+id/gdc_spin_autodetect_dialog_operator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="3dp"/>
        </TableRow>
        <TableRow
            android:id="@+id/tableRow5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <Button
                android:id="@+id/cs_btn_autodetect_country_cancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/cs_btn_cancel"
                android:layout_weight="1"/>
            <Button
                android:id="@+id/cs_btn_autodetect_country_ok"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/cs_btn_ok"
                android:layout_weight="1"/>
        </TableRow>
    </TableLayout>
</LinearLayout>
